      },
      "source": [
        "import pandas as pd\n",
        "import numpy as np"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "541ffa42"
      },
      "source": [
        "### Cause of death dataset"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "9abec7da"
      },
      "source": [
        "df = pd.read_csv("Cause_of_death.csv", sep=';', header=1, engine='python', on_bad_lines='warn')\n",
        "\n",
        "cols_to_fix = ['2014', '2015', '2016', '2017','2018', '2019', '2020', '2021', '2022', '2023', '2024']\n",
        "\n",
        "for col in cols_to_fix:\n",
        "    df[col] = pd.to_numeric(df[col].astype(str).str.replace('­­', '', regex=False).str.replace(',', '', regex=False), errors='coerce')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 310
        },
        "id": "c0ece7b7",
        "outputId": "d16a2573-d7c8-4609-97e6-9a6982829d7c"
      },
      "source": [
        "df_long = pd.melt(df, id_vars=['Measure', 'Diagnos', 'Region', 'Sex'],\n",
        "                      value_vars=cols_to_fix,\n",
        "                      var_name='Year',\n",
        "                      value_name='Number of Deaths')\n",
        "\n",
        "df_long['Year'] = pd.to_numeric(df_long['Year'])\n",
        "\n",
        "display(df_long.head())"
      ],
