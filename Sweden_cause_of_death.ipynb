    {
      "cell_type": "code",
      "metadata": {
        "id": "afa92c86"
      },
      "source": [
        "#Causes of death for year 2019\n",
        "\n",
        "deaths_2019 = df_causes[df_causes['Year'] == 2019]\n",
        "\n",
        "# Group by 'Diagnos' and sum the 'Number of Deaths'\n",
        "top_causes_2019 = deaths_2019.groupby('Diagnos')['Number of Deaths'].sum().reset_index()\n",
        "\n",
        "# Sort in descending order to see the top causes\n",
        "top_causes_2019 = top_causes_2019.sort_values(by='Number of Deaths', ascending=False)\n",
        "\n",
        "top_causes_2019['Year']=2019"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "cc10a68d"
      },
      "source": [
        "#Same for 2020\n",
        "\n",
        "deaths_2020 = df_causes[df_causes['Year'] == 2020]\n",
        "\n",
        "top_causes_2020 = deaths_2020.groupby('Diagnos')['Number of Deaths'].sum().reset_index()\n",
        "\n",
        "top_causes_2020 = top_causes_2020.sort_values(by='Number of Deaths', ascending=False)\n",
        "\n",
        "top_causes_2020['Year']=2020"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "627b7c05"
      },
      "source": [
        "#And the same for 2024\n",
        "\n",
        "deaths_2024 = df_causes[df_causes['Year'] == 2024]\n",
        "\n",
        "top_causes_2024 = deaths_2024.groupby('Diagnos')['Number of Deaths'].sum().reset_index()\n",
        "\n",
        "top_causes_2024 = top_causes_2024.sort_values(by='Number of Deaths', ascending=False)\n",
        "\n",
        "top_causes_2024['Year']=2024"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "a203198c"
      },
      "source": [
        "#I need to remove the codes for special purposes as it will show up the same as covid\n",
        "combined = pd.concat([top_causes_2019, top_causes_2020, top_causes_2024], ignore_index=True)\n",
        "combined_filtered = combined[~combined['Diagnos'].str.contains('Codes for special purposes', na=False)]"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "fa8eefa8"
      },
      "source": [
        "### Plotting"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "4c7382f3"
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "sns.set_context(\"talk\", font_scale=1.1)"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 267
        },
        "id": "fde03a0a",
        "outputId": "35d9d19f-1f06-4b44-b1d9-4d188f175d98"
      },
      "source": [
        "# Filter to top N causes (by total deaths across all years) ---\n",
        "top_n = 10\n",
        "totals = combined_filtered.groupby('Diagnos')['Number of Deaths'].sum().sort_values(ascending=False)\n",
        "top_categories = totals.head(top_n).index.tolist()\n",
        "combined_top = combined_filtered[combined_filtered['Diagnos'].isin(top_categories)]\n",
        "\n",
        "###\n",
        "fig, axes = plt.subplots(1, 2, figsize=(26, 12), gridspec_kw={'width_ratios': [1, 1.3]})\n",
        "\n",
        "sns.lineplot(data=mortality_rate_group, x='Year', y='Mortality rate', hue='Sex', marker='o', ax=axes[0])\n",
        "axes[0].set_title('Mortality Rate in Sweden by Year and Sex', fontsize=20)\n",
        "axes[0].set_xlabel('Year', fontsize=16)\n",
        "axes[0].set_ylabel('Mortality rate per 1000', fontsize=16)\n",
        "axes[0].tick_params(axis='both', labelsize=14)\n",
        "axes[0].grid(True)\n",
        "\n",
        "bars=sns.barplot(data=combined_top, y='Diagnos', x='Number of Deaths', hue='Year',\n",
        "            order=top_categories, ax=axes[1])\n",
