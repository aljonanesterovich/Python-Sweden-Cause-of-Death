      "source": [
        "df_population_long = pd.melt(df_population, id_vars=['region', 'marital status', 'sex'],\n",
        "                      value_vars= df_population.columns[3:],\n",
        "                      var_name='Year',\n",
        "                      value_name='Population size')\n",
        "\n",
        "df_population_long = df_population_long.drop(columns=['marital status'])\n",
        "\n",
        "df_population_long = df_population_long.rename(columns={'region': 'Region', 'sex': 'Sex'})\n",
        "\n",
        "df_population_long = df_population_long.groupby(['Year', 'Region', 'Sex']).sum().reset_index()\n",
        "\n",
        "df_population_long.head()"
      ],
