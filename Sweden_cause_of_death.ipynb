      "source": [
        "#Aggregate data by sex and year for mortality rate\n",
        "mortality_rate_group = df_filtered.groupby(['Sex','Year']).agg({\n",
        "    'Number of Deaths': 'sum',\n",
        "    'Population size': 'sum'\n",
        "}).reset_index()\n",
        "\n",
        "mortality_rate_group.head()\n",
        "\n",
        "#Mortality rate column (per 1000)\n",
        "mortality_rate_group['Mortality rate'] = mortality_rate_group['Number of Deaths']/mortality_rate_group['Population size']*1000\n",
        "\n",
        "mortality_rate_group.head()"
      ],
