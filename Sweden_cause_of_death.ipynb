      "source": [
        "# Function to clean region names in df_population_long\n",
        "def clean_region_name(region):\n",
        "    if isinstance(region, str):\n",
        "        # To remove the numeric prefix and ' county'\n",
        "        cleaned_name = region.split(' ', 1)[-1].replace(' county', '')\n",
        "        return cleaned_name\n",
        "    return region\n",
        "\n",
        "# Apply the cleaning function to the 'Region' column\n",
        "df_population_long['Region'] = df_population_long['Region'].apply(clean_region_name)\n",
        "\n",
        "# Explicitly rename 'Götaland' to 'Västra Götaland' to match df_long\n",
        "df_population_long['Region'] = df_population_long['Region'].replace({'Götaland': 'Västra Götaland'})"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "8aef60a8",
        "outputId": "2e24e5a3-6a82-43ca-eabb-c0e9b5421c63"
      },
      "source": [
        "df_long_cleaned = df_long.dropna(subset=['Region'])\n",
        "\n",
        "# To reset sex to be lower case\n",
        "df_long_cleaned['Sex'] = df_long_cleaned['Sex'].str.lower()\n",
        "\n",
        "# To standardize 'Sex' column in df_long_cleaned to match df_population_long\n",
        "df_long_cleaned.loc[:, 'Sex'] = df_long_cleaned['Sex'].replace({'woman': 'women'})\n",
        "\n",
        "# Ensure the 'Year' column in df_population_long is numeric\n",
        "df_population_long['Year'] = pd.to_numeric(df_population_long['Year'], errors='coerce')\n",
        "\n",
        "# Perform the merge operation again with cleaned data\n",
        "df_merged = pd.merge(df_long_cleaned, df_population_long, on=['Year', 'Region', 'Sex'], how='left')"
      ],
      "execution_count": null,
      "outputs": [
        {
