\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 284540,\n        \"min\": 28455,\n        \"max\": 1238377,\n        \"num_unique_values\": 462,\n        \"samples\": [\n          29870\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
